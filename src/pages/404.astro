---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="section" style="padding-bottom: var(--space-9)">
    <h1 class="display">Page not found</h1>
    <p class="lead">This address does not match any page. It may have moved when the site was updated.</p>
    <div class="actions"><a class="btn" href="/">Go to the Home Page</a><a class="btn-plain" href="/projects/">See All Work</a></div>
  </section>
</Base>
