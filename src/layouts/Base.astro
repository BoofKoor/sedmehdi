---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TabBar from '../components/TabBar.astro';
import { site } from '../data/site';
interface Props { title?: string; description?: string; back?: { href: string; label: string } }
const { title, description = site.description, back } = Astro.props;
const fullTitle = title ? `${title}, ${site.wordmark}` : `${site.name}, ${site.wordmark}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <!-- the browser bar takes the page colour (synced with the theme switch below) -->
  <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)">
  <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
  <script is:inline>
    try { var t = localStorage.getItem('sm-theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to Content</a>
  <!-- Background: a honeycomb of the monogram's 2:1 hexagon, with coral packets travelling along its edges. Decorative only. -->
  <div class="bg" aria-hidden="true"><div class="bg-grid"></div><canvas></canvas></div>
  <Header back={back} />
  <div class="wrap">
    <main id="main"><slot /></main>
    <Footer />
  </div>
  <TabBar />
  <script is:inline>
    // Phones: the browser bar follows the page background (after the theme switch too), and sections rise in
    // gently as they scroll into view. Nothing above the fold is hidden, and Reduce Motion turns the rise off.
    (function () {
      function sync() {
        var c = getComputedStyle(document.documentElement).getPropertyValue('--color-background').trim();
        if (c) document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) { m.setAttribute('content', c); });
      }
      sync(); new MutationObserver(sync).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', sync);
      if (!matchMedia('(max-width: 720px)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches || !window.IntersectionObserver) return;
      var SEL = 'main .section-title, main .areas > div, main .timeline li, main .skills > div, main .next-card, main .contact-list, main .doc-card, main .fact, main .prose > *';
      var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -8% 0px' });
      var queued = false;
      function scan() {
        queued = false;
        document.querySelectorAll(SEL).forEach(function (el) {
          if (el.hasAttribute('data-rv')) return; el.setAttribute('data-rv', '');
          if (el.getBoundingClientRect().top < innerHeight) return;  // already on screen: never hidden
          el.classList.add('rv'); io.observe(el);
        });
      }
      scan(); new MutationObserver(function () { if (!queued) { queued = true; requestAnimationFrame(scan); } }).observe(document.body, { childList: true, subtree: true });
    })();
  </script>
  <script is:inline>
    // Theme switch. The new theme opens as a circle from the switch (View Transitions), or changes at once
    // where that API is missing or Reduce Motion is on.
    (function () {
      var root = document.documentElement, btn = document.getElementById('theme');
      if (!btn) return;
      var sys = matchMedia('(prefers-color-scheme: dark)'), still = matchMedia('(prefers-reduced-motion: reduce)');
      function current() { return root.getAttribute('data-theme') || (sys.matches ? 'dark' : 'light'); }
      function paint() { btn.setAttribute('aria-checked', String(current() === 'dark')); }
      function apply(next) { root.setAttribute('data-theme', next); try { localStorage.setItem('sm-theme', next); } catch (e) {} paint(); }
      paint();
      if (sys.addEventListener) sys.addEventListener('change', paint);
      btn.addEventListener('click', function () {
        var next = current() === 'dark' ? 'light' : 'dark';
        if (!document.startViewTransition || still.matches) { apply(next); return; }
        var r = btn.getBoundingClientRect(), x = r.left + r.width / 2, y = r.top + r.height / 2;
        var end = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        root.classList.add('theme-vt');
        document.documentElement.classList.add('vt-theme');  // named elements would escape the circle: unname them for this one
        var vt = document.startViewTransition(function () { apply(next); });
        vt.finished.then(function () { document.documentElement.classList.remove('vt-theme'); });
        vt.ready.then(function () {
          root.animate({ clipPath: ['circle(0px at ' + x + 'px ' + y + 'px)', 'circle(' + end + 'px at ' + x + 'px ' + y + 'px)'] },
            { duration: 700, easing: 'cubic-bezier(.2, .7, .2, 1)', pseudoElement: '::view-transition-new(root)' });
        });
        vt.finished.finally(function () { root.classList.remove('theme-vt'); });
      });
    })();
    // Sticky bar: gets its material and hairline once it is actually pinned.
    (function () {
      var bar = document.querySelector('.bar'), queued = false;
      if (!bar) return;
      function update() {
        queued = false;
        var pinnedAt = parseFloat(getComputedStyle(bar).top) || 0;
        bar.toggleAttribute('data-stuck', window.scrollY > 0 && bar.getBoundingClientRect().top <= pinnedAt + 0.5);
      }
      addEventListener('scroll', function () { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
      addEventListener('resize', update);
      update();
    })();
    // Background packets: short coral pulses that travel the honeycomb edges like traffic through a network.
    // When the page has a hub (the hero mark, window.smHub), they steer to it and it absorbs them on arrival.
    // Paused when off screen or in a hidden tab; never started when Reduce Motion is on.
    (function () {
      var bg = document.querySelector('.bg'), cv = bg && bg.querySelector('canvas');
      if (!cv || !cv.getContext || !window.ResizeObserver || !window.IntersectionObserver) return;
      var ctx = cv.getContext('2d'), still = matchMedia('(prefers-reduced-motion: reduce)');
      // Honeycomb of the grid (tile 66x114, regular hexagons with 38px sides): a vertex is either "up" (one edge up, two down) or "down"
      // (one edge down, two up), and every edge joins one of each, so a packet alternates between the two.
      var UP = [[0, -38], [-33, 19], [33, 19]], DOWN = [[0, 38], [-33, -19], [33, -19]];
      var w = 0, h = 0, packets = [], raf = 0, last = 0, visible = true, rgb = [234, 85, 85];
      var hex = getComputedStyle(document.documentElement).getPropertyValue('--color-tint').trim();
      if (/^#[0-9a-f]{6}$/i.test(hex)) rgb = [1, 3, 5].map(function (i) { return parseInt(hex.slice(i, i + 2), 16); });
      function rgba(a) { return 'rgba(' + rgb[0] + ',' + rgb[1] + ',' + rgb[2] + ',' + Math.max(0, a).toFixed(3) + ')'; }
      function size() {
        var r = bg.getBoundingClientRect(), dpr = Math.min(2, window.devicePixelRatio || 1);
        w = r.width; h = r.height; cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      function spawn() {  // start at the top ("up") or bottom ("down") vertex of a random cell in the upper part
        var t = hub(), up = Math.random() < 0.5, r, x;
        if (t && Math.random() < (w > 720 ? 0.55 : 0.85)) {  // a hub on the page: many packets start a few cells away (on phones it is small, so most)
          var c = t.center(), br = bg.getBoundingClientRect(), tx = c[0] - br.left, ty = c[1] - br.top;
          r = Math.max(1, Math.round(ty / 57) + Math.round((Math.random() - 0.5) * 6));   // within about 3 rows
          x = 66 * (Math.round(tx / 66) + Math.round((Math.random() - 0.5) * 8)) + (r % 2 ? 33 : 0);   // and 4 columns
        } else {
          r = 1 + Math.floor(Math.random() * (h * 0.55 / 57));
          x = 66 * Math.floor(Math.random() * (w / 66 + 1)) + (r % 2 ? 33 : 0);
        }
        var y = 57 * r + (up ? -38 : 38);
        packets.push({ pts: [[x, y]], x: x, y: y, up: up, d: (up ? UP : DOWN)[Math.floor(Math.random() * 3)], age: 0, life: 4000 + Math.random() * 4000, v: 34 + Math.random() * 22 });
      }
      function hub() { var h = window.smHub; return h && h.active && h.active() ? h : null; }
      function turn(k) {  // arrived at a vertex of the other kind: two ways on, never back
        k.up = !k.up;
        var ok = (k.up ? UP : DOWN).filter(function (e) { return !(e[0] === -k.d[0] && e[1] === -k.d[1]); });
        var h = hub();
        if (h && Math.random() < 0.8) {  // a hub on the page: mostly take the edge that gets closer to it
          var c = h.center(), r = bg.getBoundingClientRect(), tx = c[0] - r.left, ty = c[1] - r.top;
          ok.sort(function (a, b) { return Math.hypot(k.x + a[0] - tx, k.y + a[1] - ty) - Math.hypot(k.x + b[0] - tx, k.y + b[1] - ty); });
          k.d = ok[0]; return;
        }
        k.d = ok[Math.floor(Math.random() * ok.length)];
      }
      function step(k, dt) {
        var move = k.v * dt / 1000;
        while (move > 0) {
          var from = k.pts[k.pts.length - 1], tx = from[0] + k.d[0], ty = from[1] + k.d[1];
          var dx = tx - k.x, dy = ty - k.y, dist = Math.hypot(dx, dy);
          if (dist <= move) { k.x = tx; k.y = ty; k.pts.push([tx, ty]); if (k.pts.length > 6) k.pts.shift(); turn(k); move -= dist; }
          else { k.x += dx / dist * move; k.y += dy / dist * move; move = 0; }
        }
      }
      function draw(k) {
        var a = Math.min(1, k.age / 500, (k.life - k.age) / 700), TRAIL = 64;
        if (a <= 0) return;
        var pts = [[k.x, k.y]].concat(k.pts.slice().reverse()), left = TRAIL;
        ctx.lineWidth = 1.4; ctx.lineCap = 'round';
        for (var i = 0; i < pts.length - 1 && left > 0; i++) {
          var p = pts[i], q = pts[i + 1], seg = Math.hypot(q[0] - p[0], q[1] - p[1]);
          if (!seg) continue;
          var f = Math.min(1, left / seg), qx = p[0] + (q[0] - p[0]) * f, qy = p[1] + (q[1] - p[1]) * f;
          var g = ctx.createLinearGradient(p[0], p[1], qx, qy);
          g.addColorStop(0, rgba(a * 0.9 * left / TRAIL)); g.addColorStop(1, rgba(a * 0.9 * (left - seg * f) / TRAIL));
          ctx.strokeStyle = g; ctx.beginPath(); ctx.moveTo(p[0], p[1]); ctx.lineTo(qx, qy); ctx.stroke();
          left -= seg * f;
        }
        ctx.fillStyle = rgba(a); ctx.shadowColor = rgba(a); ctx.shadowBlur = 10;
        ctx.beginPath(); ctx.arc(k.x, k.y, 2, 0, Math.PI * 2); ctx.fill(); ctx.shadowBlur = 0;
      }
      function frame(t) {
        raf = requestAnimationFrame(frame);
        var dt = Math.min(64, t - (last || t)); last = t;
        ctx.clearRect(0, 0, w, h);
        var busy = !!hub();  // with a hub, a little more traffic so arrivals are regular
        if (packets.length < (w > 720 ? (busy ? 7 : 6) : (busy ? 4 : 3)) && Math.random() < dt / (busy ? 600 : 700)) spawn();
        var target = hub(), r = target && bg.getBoundingClientRect(), hc = target && target.center();  // not "h": that is the canvas height
        packets = packets.filter(function (k) {
          // packets near the hub live long enough to reach it; far ones die as usual, so new ones can start near it
          k.age += dt; if (target && k.life < 12000 && Math.hypot(r.left + k.x - hc[0], r.top + k.y - hc[1]) < 480) k.life = 12000;
          step(k, dt);
          if (target && target.hit(r.left + k.x, r.top + k.y)) return false;  // absorbed by the hub
          draw(k); return k.age < k.life;
        });
      }
      function run() { if (!raf && visible && !document.hidden && !still.matches) { last = 0; raf = requestAnimationFrame(frame); } }
      function stop() { if (raf) { cancelAnimationFrame(raf); raf = 0; } }
      size();
      if (!still.matches) spawn();
      new ResizeObserver(size).observe(bg);
      new IntersectionObserver(function (e) { visible = e[0].isIntersecting; if (visible) run(); else stop(); }).observe(bg);
      document.addEventListener('visibilitychange', function () { if (document.hidden) stop(); else run(); });
      if (still.addEventListener) still.addEventListener('change', function () { if (still.matches) { stop(); ctx.clearRect(0, 0, w, h); } else run(); });
      run();
    })();
  </script>
</body>
</html>
