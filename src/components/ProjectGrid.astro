---
// Project cards (bento): the first project is the large card. Each card is one link in the project's own colour; the
// screenshot sits in a browser window that runs off the bottom edge and rises on hover. The link's name is the title
// ("GozarX case study"); the summary, status and number are its description.
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
import { statusState } from '../data/status';
import { demoLabel } from '../data/links';
import { lastWord } from '../data/title';
interface Props { projects: CollectionEntry<'projects'>[]; carousel?: boolean }
const { projects, carousel = false } = Astro.props;
const host = (p: CollectionEntry<'projects'>) => (p.data.demo ? demoLabel(p.data.demo, Astro.site) : p.id);
---
<div class={carousel ? 'framed carousel' : 'framed'}>
  {projects.map((project, i) => { const p = project.data, id = project.id, lead = i === 0, [head, last] = lastWord(p.title); return (
    <a class={lead ? 'fr-card fr-lead' : 'fr-card'} href={`/projects/${id}/`} data-device={p.device} style={`${p.accent ? `--accent:${p.accent};` : ''}${p.logo ? ` --tint:${p.logo.tint}; --logo-bg:${p.logo.bg};` : ''}`}
       aria-labelledby={`fr-t-${id}`} aria-describedby={`fr-d-${id}`}>
      <span class="fr-text">
        {p.logo && <span class="pj-logo" aria-hidden="true"><img src={p.logo.src} alt="" width="64" height="64" decoding="async" /></span>}
        <span class="fr-title vtt" id={`fr-t-${id}`} style={`--vtt: vt-t-${id}`}>{head}<span class="tw">{last}<span class="vh"> case study</span><Arrow id={`f-${id}`} /></span></span>
        <span class="fr-desc" id={`fr-d-${id}`}>
          {lead && <span class="fr-sum">{p.summary}</span>}
          <span class="fr-meta"><span class="led" data-state={statusState(p.status)} aria-hidden="true"></span>{p.status}</span>
          {lead && p.metric && <span class="fr-kpi">{p.metric.value}<small>{p.metric.label}</small></span>}
        </span>
      </span>
      {p.cover && p.device === 'phone' && <span class="phone fr-phone vtc" style={`--vtc: vt-c-${id}`} aria-hidden="true"><span class="window-view phone-view"><img src={p.cover.src} alt="" width="780" height="1688" loading="lazy" decoding="async" /></span></span>}
      {p.cover && p.device !== 'phone' && <span class="window fr-window vtc" style={`--vtc: vt-c-${id}`} aria-hidden="true"><span class="window-bar"><span class="window-url"><svg viewBox="0 0 12 14" focusable="false"><path d="M3 6V4a3 3 0 0 1 6 0v2M2 6h8v7H2z"/></svg>{host(project)}</span></span><span class="window-view"><img src={p.cover.src} alt="" width="1600" height="1000" loading="lazy" decoding="async" /></span></span>}
    </a>
  ); })}
</div>
{carousel && <div class="dots" aria-hidden="true">{projects.map((_, i) => <span class={i === 0 ? 'dot on' : 'dot'}></span>)}</div>}
<script is:inline>
  // Touch screens have no hover: the card in view (the snapped one in the carousel, or the one crossing the middle of
  // the screen in a list) gets .is-inview, which raises its window or phone; the carousel's dots follow the swipe.
  (function () {
    if (!window.IntersectionObserver) return;
    document.querySelectorAll('.framed:not([data-bound])').forEach(function (grid) {
      grid.setAttribute('data-bound', '');
      var cards = [].slice.call(grid.querySelectorAll('.fr-card')), dots = grid.nextElementSibling && grid.nextElementSibling.classList.contains('dots') ? [].slice.call(grid.nextElementSibling.children) : [];
      var swipe = grid.classList.contains('carousel') && getComputedStyle(grid).overflowX === 'auto';
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          e.target.classList.toggle('is-inview', e.isIntersecting);
          if (e.isIntersecting && dots.length) { var k = cards.indexOf(e.target); dots.forEach(function (d, j) { d.classList.toggle('on', j === k); }); }
        });
      }, swipe ? { root: grid, threshold: 0.6 } : { rootMargin: '-35% 0px -35% 0px' });
      cards.forEach(function (c) { io.observe(c); });
      // Keyboard: the card taking focus comes wholly into view (and its dot with it, through the observer).
      // Chromium does not scroll a scroller for an element that is already partly showing, so Tab left the
      // next card a sliver at the edge of the screen, its focus ring with it. When it does scroll, a scroll
      // issued inside the focus event cancelled its own and put the card back off screen, so this waits a
      // frame and moves only a card that is still not wholly showing.
      if (grid.classList.contains('carousel')) grid.addEventListener('focusin', function (e) {
        var card = e.target.closest && e.target.closest('.fr-card');
        if (!card || getComputedStyle(grid).overflowX !== 'auto') return;
        requestAnimationFrame(function () {
          var g = grid.getBoundingClientRect(), r = card.getBoundingClientRect();
          if (r.left >= g.left - 1 && r.right <= g.right + 1) return;
          var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
          grid.scrollBy({ left: r.left + r.width / 2 - (g.left + g.width / 2), behavior: still ? 'auto' : 'smooth' });
        });
      });
    });
  })();
</script>
