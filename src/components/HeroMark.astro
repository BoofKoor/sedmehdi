---
import { MARK_PATH } from '../data/mark';
---
<!-- Hero mark: the monogram as the hub of the background network. Packets travel the honeycomb toward it; where one
     reaches the outline, a light runs along it both ways and a ring opens (script in pages/index.astro). Decorative. -->
<svg class="hub" viewBox="-24 -24 652 1048" focusable="false">
  <path class="hub-flash" d={MARK_PATH} />
  <path class="hub-fill" d={MARK_PATH} />
  <path class="hub-line" d={MARK_PATH} pathLength="1" />
  <g class="hub-pulses"></g>
</svg>
