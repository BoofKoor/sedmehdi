{
  "name": "admin-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A white-label admin panel demo, adapted from the GozarX admin panel, running on synthetic data at /lab/admin/.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "tsc --noEmit -p tsconfig.test.json && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "palettes": "node scripts/gen-palettes.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sonner": "^1.7.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
